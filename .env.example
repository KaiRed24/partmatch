NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=gemini            # gemini (free) | anthropic | openai
AI_VISION_MODEL=gemini-3.8-flash   # for anthropic use claude-opus-5-5
AI_VISION_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-flash-lite-latest   # used when the main model is busy
AI_EMBEDDING_MODEL=gemini-embedding-001   # for openai use text-embedding-3-small
EMBEDDING_PROVIDER=gemini        # gemini (free) | openai
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
N8N_DELAY_WEBHOOK_URL=
RESEND_API_KEY=
ADMIN_PASSWORD=
CONFIDENCE_THRESHOLD=0.75
DESPATCH_CUTOFF=12:30
CHOICE_TOKEN_SECRET=   # any long random string; signs the Wait/Part-ship/Refund links
NEXT_PUBLIC_APP_URL=http://localhost:3000   # set to your Vercel URL when deployed
EMAIL_FROM=PartMatch Demo <onboarding@resend.dev>   # Resend test sender: only delivers to your own Resend account email
